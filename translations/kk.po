#. Asked before riding; the player squats and swings her arms.
#: scenes/free_space/free_space.gd
#, fuzzy
msgid "Make room! Nothing within 1 m around you: about 2 × 2 m free."
msgstr "Орын босат! Айналаңда 1 м ішінде ештеңе болмасын: шамамен 2 × 2 м."

#. Two metres, the side of the free square on the floor.
#: scenes/free_space/free_space.gd
#, fuzzy
msgid "2 m"
msgstr "2 м"

#. The button which keeps the rider and starts the game.
#: scenes/free_space/free_space.gd scenes/instruction/instruction.gd
#: scenes/rider_creator/rider_creator.gd
#, fuzzy
msgid "Ready!"
msgstr "Жолға!"

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Stand in front of the camera, like your rider."
msgstr "Шабандозың сияқты камераның алдында тұр."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Squat to make your horse run: the faster you squat, the faster it runs!"
msgstr "Отырып-тұр, сонда атың шабады: неғұрлым жылдам отырсаң, соғұрлым жылдам шабады!"

#. How to squat safely, after "Squat to make your horse run".
#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Feet apart, back straight."
msgstr "Аяқтарың иық деңгейінде, арқаң тік."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Stop squatting, and your horse slows down and stops."
msgstr "Отыруды тоқтатсаң, атың баяулап, тоқтайды."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Pull the reins: both hands to the left, and your horse turns left."
msgstr "Тізгінді тарт: екі қолың солға, сонда атың солға бұрылады."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Both hands to the right, and your horse turns right."
msgstr "Екі қолың оңға, сонда атың оңға бұрылады."

#. The button which starts the game.
#: scenes/intro/intro.gd
#, fuzzy
msgid "Play"
msgstr "Ойнау"

#. The button which opens the map with all the levels.
#: scenes/intro/intro.gd
#, fuzzy
msgid "Levels"
msgstr "Деңгейлер"

#. The button which shows how to ride by squatting and pulling the reins.
#: scenes/intro/intro.gd
#, fuzzy
msgid "How to Play"
