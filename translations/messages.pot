#: data/levels/06_along_the_esil.tscn
msgid "Good day, {rider}! Two sheep went over the river."
msgstr ""

#. what a person says to the rider, at most two short sentences; {rider} is her name
#: data/levels/06_along_the_esil.tscn
msgid "Hello, {rider}! Your horses graze on my side of the river."
msgstr ""

#. the name of a level, a few words
#: data/levels/07_the_salt_lake.tscn
msgid "The salt lake"
msgstr ""

#. what Grandmother says when all the animals are home; {rider} is the rider's name
#: data/levels/07_the_salt_lake.tscn
msgid "Thank you, {rider}! You rode across the whole salt steppe!"
msgstr ""

#. what a person says to the rider, at most two short sentences; {rider} is her name
#: data/levels/07_the_salt_lake.tscn
msgid ""
"Our camels went towards the salt lake, {rider}. Its water is too salty, so let your horse drink "
"elsewhere!"
msgstr ""

#. what a person says to the rider, at most two short sentences; {rider} is her name
#: data/levels/07_the_salt_lake.tscn
msgid "Good day, {rider}! I saw sheep far in the east."
msgstr ""

#. what a person says to the rider, at most two short sentences; {rider} is her name
#: data/levels/07_the_salt_lake.tscn
msgid "Hello, {rider}! Horses run between the rock and the bushes."
msgstr ""

#. the name of a level, a few words
#: data/levels/08_the_herders_request.tscn
msgid "The herder's request"
msgstr ""

#. what Grandmother says when all the animals are home; {rider} is the rider's name
#: data/levels/08_the_herders_request.tscn
msgid "Thank you, {rider}! Asking around helped!"
msgstr ""

#. what a person says to the rider, at most two short sentences; {rider} is her name
#: data/levels/08_the_herders_request.tscn
msgid "Our camels are gone, {rider}! Ask the shepherd at the well; he sees far."
msgstr ""

#. what a person says to the rider, at most two short sentences; {rider} is her name
#: data/levels/08_the_herders_request.tscn
msgid "Good day, {rider}! The beekeeper by the birch grove saw your camels. And I saw sheep."
msgstr ""

#. what a person says to the rider, at most two short sentences; {rider} is her name
#: data/levels/08_the_herders_request.tscn
msgid "Hello, {rider}! Yes, I saw your camels."
msgstr ""

#. the name of a level, a few words
#: data/levels/09_autumn_migration.tscn
msgid "Autumn migration"
msgstr ""

#. what Grandmother says when all the animals are home; {rider} is the rider's name
#: data/levels/09_autumn_migration.tscn
msgid "Thank you, {rider}! The whole herd is ready for the winter pastures."
msgstr ""

#. what a person says to the rider, at most two short sentences; {rider} is her name
#: data/levels/09_autumn_migration.tscn
msgid "Autumn has come, {rider}. We move to the winter pastures, but our animals are scattered!"
msgstr ""

#. what a person says to the rider, at most two short sentences; {rider} is her name
#: data/levels/09_autumn_migration.tscn
msgid "Good day, {rider}! I saw camels and horses on my way."
msgstr ""

#. the name of a level, a few words
#: data/levels/10_the_first_snow.tscn
msgid "The first snow"
msgstr ""

#. what Grandmother says when all the animals are home; {rider} is the rider's name
#: data/levels/10_the_first_snow.tscn
msgid ""
"Thank you, {rider}! Everyone is home before the snow. Let's celebrate with the dombra and songs!"
msgstr ""

#. what a person says to the rider, at most two short sentences; {rider} is her name
#: data/levels/10_the_first_snow.tscn
msgid "The first snow is coming, {rider}! Bring everyone home, and we will celebrate together."
msgstr ""

#. what a person says to the rider, at most two short sentences; {rider} is her name
#: data/levels/10_the_first_snow.tscn
msgid "Good day, {rider}! I saw horses by the lake and sheep by the spring."
msgstr ""

#. what a person says to the rider, at most two short sentences; {rider} is her name
#: data/levels/10_the_first_snow.tscn
