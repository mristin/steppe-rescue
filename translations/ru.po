#. what a person says to the rider, at most two short sentences; {rider} is her name
#: data/levels/01_the_lamb_by_the_spring.tscn
#, fuzzy
msgid "Our lamb ran off in the night. Please bring it home, {rider}!"
msgstr "Ночью наш ягнёнок убежал. Пожалуйста, приведи его домой, {rider}!"

#. the name of a level, a few words
#: data/levels/02_after_the_storm.tscn
#, fuzzy
msgid "After the storm"
