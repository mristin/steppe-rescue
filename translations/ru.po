#. what a person says to the rider, at most two short sentences; {rider} is her name
#: data/levels/05_the_birch_groves.tscn data/levels/09_autumn_migration.tscn
#, fuzzy
msgid "Hello, {rider}! Your sheep visited my bees."
msgstr "Привет, {rider}! Твои овцы заходили к моим пчёлам."

#. the name of a level, a few words
#: data/levels/06_along_the_esil.tscn
#, fuzzy
msgid "Along the Esil"
