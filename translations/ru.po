#. Asked before riding; the player squats and swings her arms.
#: scenes/free_space/free_space.gd
#, fuzzy
msgid "Make room! Nothing within 1 m around you: about 2 × 2 m free."
msgstr "Освободи место! Вокруг тебя ничего ближе 1 м: около 2 × 2 м."

#. Two metres, the side of the free square on the floor.
#: scenes/free_space/free_space.gd
#, fuzzy
msgid "2 m"
